@page "/projects"

<PageTitle>Projects — Jason Parent</PageTitle>

<div class="page-header">
    <div class="container">
        <h1>Projects</h1>
        <p class="page-subtitle">From bridge data systems to AI-powered consulting</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="projects-grid">
            <!-- BridgeInsight (Featured) -->
            <div class="project-card project-card--featured">
                <div class="project-badge">
                    <span class="badge badge-info">Featured</span>
                    <span class="badge badge-success">Live</span>
                </div>
                <h2>BridgeInsight</h2>
                <p class="project-subtitle">Explainable AI for Bridge Data Intelligence</p>
                <p>
                    Offline-capable PWA using Blazor WASM + SQLite that turns raw NBI data into
                    trustworthy, explainable analysis. AI-generated narratives with full chain-of-evidence
                    traceability.
                </p>
                <div class="project-tech">
                    <span class="skill-tag">Blazor WASM</span>
                    <span class="skill-tag">EF Core</span>
                    <span class="skill-tag">SQLite</span>
                    <span class="skill-tag">Claude API</span>
                    <span class="skill-tag">RAG</span>
                    <span class="skill-tag">PWA</span>
                    <span class="skill-tag">GitHub Actions</span>
                </div>
                <div class="project-actions">
                    <a href="bridgeinsight" class="btn btn-accent">Try Live Demo</a>
                    <a href="https://github.com/Skyliner33v/BridgeInsight" target="_blank" class="btn btn-outline">View Source</a>
                </div>
            </div>

            <!-- SAM Web Application -->
            <div class="project-card">
                <div class="project-badge">
                    <span class="badge badge-warning">In Progress</span>
                </div>
                <h3>SAM Web Application</h3>
                <p class="project-subtitle">Legacy to Modern — Bridge Asset Management Migration</p>
                <p>
                    Leading the migration of multiple legacy Microsoft Access applications to a modern
                    Blazor Server web front-end backed by SQL Server. Consolidating fragmented bridge
                    data systems into a unified Structure Asset Management (SAM) platform — serving
                    50+ engineers and inspectors statewide, managing data for 8,400+ structures.
                </p>
                <div class="project-tech">
                    <span class="skill-tag">Blazor Server</span>
                    <span class="skill-tag">C#/.NET</span>
                    <span class="skill-tag">EF Core</span>
                    <span class="skill-tag">SQL Server</span>
                    <span class="skill-tag">Azure DevOps</span>
                    <span class="skill-tag">Python</span>
                </div>
                <p class="project-note">Internal WSDOT application — code not publicly available</p>
            </div>

            <!-- NW OpsBridge -->
            <div class="project-card">
                <div class="project-badge">
                    <span class="badge badge-success">Active</span>
                </div>
                <h3>NW OpsBridge Automations</h3>
                <p class="project-subtitle">AI-Powered Automation Consulting for Trades & Service Businesses</p>
                <p>
                    Founded and operate a sole proprietorship providing automation consulting.
                    Built from scratch: LLC registration, website on Google Cloud Run with Three.js 3D visuals,
                    integrated scheduling with payment processing, Facebook ads, and AI-powered chatbots.
                </p>
                <div class="project-tech">
                    <span class="skill-tag">Google Cloud Run</span>
                    <span class="skill-tag">HTML/CSS/JS</span>
                    <span class="skill-tag">Stripe</span>
                    <span class="skill-tag">Google Gemini</span>
                    <span class="skill-tag">Three.js</span>
                    <span class="skill-tag">SEO</span>
                </div>
                <div class="project-actions">
                    <a href="https://www.nwopsbridge.com" target="_blank" class="btn btn-outline">Visit Site</a>
                </div>
            </div>

            <!-- LeadProspector -->
            <div class="project-card">
                <div class="project-badge">
                    <span class="badge badge-success">Active</span>
                </div>
                <h3>LeadProspector</h3>
                <p class="project-subtitle">Python CLI + Web App — Data Pipeline for Lead Scoring</p>
                <p>
                    Built a Python tool that scrapes the WA State L&amp;I contractor database, discovers
                    business websites, scores them on a 0-100 quality scale, and outputs prioritized
                    lead lists with auto-generated pitch angles. Full data pipeline:
                    Source &rarr; Probe &rarr; Score &rarr; Rank &rarr; Output.
                </p>
                <div class="project-tech">
                    <span class="skill-tag">Python</span>
                    <span class="skill-tag">Web Scraping</span>
                    <span class="skill-tag">Data Pipelines</span>
                    <span class="skill-tag">CLI Architecture</span>
                    <span class="skill-tag">Scoring Algorithms</span>
                    <span class="skill-tag">pytest</span>
                </div>
                <p class="project-note">Built for NW OpsBridge Automations — internal business tool</p>
            </div>

            <!-- BlissRoms -->
            <div class="project-card">
                <div class="project-badge">
                    <span class="badge badge-demo">Historical</span>
                </div>
                <h3>BlissRoms / Open Source Android</h3>
                <p class="project-subtitle">Custom Android ROM Development & Creative Design</p>
                <p>
                    Former contributor to the BlissRoms open-source Android project.
                    Maintained customized ROM builds, coordinating remote builds via SSH on
                    dedicated Linux build servers. Created boot animations and visual assets.
                </p>
                <div class="project-tech">
                    <span class="skill-tag">Android AOSP</span>
                    <span class="skill-tag">Linux</span>
                    <span class="skill-tag">Git</span>
                    <span class="skill-tag">After Effects</span>
                    <span class="skill-tag">Photoshop</span>
                </div>
                <p class="project-note">2014-2016 — Organizations still active at <a href="https://blisslabs.org" target="_blank">blisslabs.org</a></p>
            </div>

            <!-- Arduino Chicken Coop -->
            <div class="project-card">
                <div class="project-badge">
                    <span class="badge badge-demo">Hardware</span>
                </div>
                <h3>Arduino Automated Coop Controller</h3>
                <p class="project-subtitle">IoT — Sensor-Driven Automation with Microcontrollers</p>
                <p>
                    Built an automated chicken coop door controller using an Arduino microcontroller
                    with light sensors and motor drivers. The system opened and closed the coop door
                    based on ambient light levels — eliminating twice-daily manual trips. A small
                    project, but representative of how I approach problems: if it can be automated,
                    it should be.
                </p>
                <div class="project-tech">
                    <span class="skill-tag">Arduino</span>
                    <span class="skill-tag">C++</span>
                    <span class="skill-tag">Sensors</span>
                    <span class="skill-tag">Motor Control</span>
                    <span class="skill-tag">Electronics</span>
                </div>
                <p class="project-note">Personal project — hardware + software integration</p>
            </div>
        </div>
    </div>
</section>
