@page "/bridgeinsight"
@inject DatabaseService DbService
@inject ClaudeAnalysisService AnalysisService

<PageTitle>BridgeInsight — Bridge Data Intelligence</PageTitle>

<div class="page-header">
    <div class="container">
        <h1>BridgeInsight</h1>
        <p class="page-subtitle">Explainable AI for Bridge Data Intelligence</p>
    </div>
</div>

<section class="section">
    <div class="container">
        @if (!DbService.IsInitialized)
        {
            <div class="init-panel">
                <div class="spinner"></div>
                <h3>Initializing BridgeInsight</h3>
                <p>Loading Washington State bridge data...</p>
            </div>
        }
        else
        {
            <div class="stats-bar">
                <div class="stat-item">
                    <div class="stat-value">@DbService.BridgeCount.ToString("N0")</div>
                    <div class="stat-label">Washington State Bridges</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">2024</div>
                    <div class="stat-label">NBI Data Year</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">FHWA</div>
                    <div class="stat-label">Data Source</div>
                </div>
            </div>

            <div class="browser-notice">
                <span class="browser-notice-icon">&#9432;</span>
                <p>BridgeInsight runs entirely in your browser. The SQLite database, AI inference, and all data processing happen client-side via WebAssembly. First loads may take a moment while the runtime initializes.</p>
            </div>

            <!-- API Key / Analysis Mode Section -->
            <div class="api-section">
                <h4>Analysis Mode</h4>

                @if (hasApiKey)
                {
                    <div class="api-key-active">
                        <div class="api-active-info">
                            <span class="mode-badge mode-badge--live">Live</span>
                            <div>
                                <strong>Live Analysis Active</strong>
                                <p>Your Claude API key is stored in this browser. All bridge and portfolio analyses will use the Claude API for real-time results.</p>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline" @onclick="ClearApiKey">Remove Key</button>
                    </div>
                }
                else
                {
                    <div class="api-choice">
                        <div class="api-option @(showApiKeyInput ? "api-option--selected" : "")" @onclick="() => showApiKeyInput = true">
                            <div class="api-option-icon">🔑</div>
                            <h5>Use Your API Key</h5>
                            <p>Run live AI analysis for any bridge or portfolio. Calls the Claude API directly from your browser.</p>
                            @if (showApiKeyInput)
                            {
                                <div class="api-key-form" @onclick:stopPropagation="true">
                                    <input type="password" class="form-control" placeholder="sk-ant-api03-..."
                                           @bind="apiKeyInput" @bind:event="oninput"
                                           @onkeydown="HandleKeyDown" />
                                    <button class="btn btn-sm btn-accent" @onclick="SaveApiKey"
                                            disabled="@string.IsNullOrWhiteSpace(apiKeyInput)">Save Key</button>
                                    <p class="api-key-note">Your key is stored only in this browser's localStorage and sent only to Anthropic's API. It never touches any other server.</p>
                                </div>
                            }
                        </div>
                        <div class="api-option" @onclick="() => showApiKeyInput = false">
                            <div class="api-option-icon">📦</div>
                            <h5>Demo Mode</h5>
                            <p>Explore with pre-cached AI responses for select bridges and portfolios. No API key needed, and it works instantly.</p>
                            <span class="mode-badge mode-badge--demo">Active by Default</span>
                        </div>
                    </div>
                }
            </div>

            <div class="app-nav-cards">
                <a href="bridgeinsight/explorer" class="app-nav-card">
                    <h3>Bridge Explorer</h3>
                    <p>Search, filter, and browse all @DbService.BridgeCount.ToString("N0") bridges with sortable columns, condition filters, and detailed data views.</p>
                    <span class="app-nav-link">Open Explorer &rarr;</span>
                </a>
                <a href="bridgeinsight/portfolio" class="app-nav-card">
                    <h3>Portfolio Analysis</h3>
                    <p>Generate AI-powered risk briefings across multiple bridges with tier classification, pattern analysis, and funding narratives.</p>
                    <span class="app-nav-link">Open Analysis &rarr;</span>
                </a>
                <a href="bridgeinsight/ask-snbi" class="app-nav-card">
                    <h3>Ask the SNBI Guide</h3>
                    <p>Document-grounded Q&amp;A over the FHWA SNBI specification. Every claim cites the section it came from, with the retrieved excerpts shown in full.</p>
                    <span class="app-nav-link">Open SNBI Guide &rarr;</span>
                </a>
                <a href="bridgeinsight/condition-ai" class="app-nav-card app-nav-card--prototype">
                    <span class="prototype-ribbon">Exploratory Prototype</span>
                    <h3>Condition AI</h3>
                    <p>In-browser ML inference using ONNX Runtime Web. Predicts bridge deterioration risk from NBI features, no server required.</p>
                    <span class="app-nav-link">Open Condition AI &rarr;</span>
                </a>
            </div>

            <div class="demo-notice">
                <h4>Why BridgeInsight?</h4>
                <p>
                    Built by a 20-year WSDOT bridge data specialist with extensive daily AASHTOWare BrM experience,
                    BridgeInsight explores how explainable AI can augment bridge management workflows
                    by turning raw NBI data into trustworthy, evidence-traced narratives that engineers
                    can verify against the source data.
                </p>
            </div>
        }
    </div>
</section>

@code {
    private bool hasApiKey;
    private bool showApiKeyInput;
    private string apiKeyInput = "";
    private bool hasCheckedKey;

    protected override async Task OnInitializedAsync()
    {
        if (!DbService.IsInitialized)
        {
            await DbService.InitializeAsync();
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || !hasCheckedKey)
        {
            hasCheckedKey = true;
            var key = await AnalysisService.GetApiKeyAsync();
            var newHasApiKey = !string.IsNullOrEmpty(key);
            if (newHasApiKey != hasApiKey)
            {
                hasApiKey = newHasApiKey;
                StateHasChanged();
            }
        }
    }

    private async Task SaveApiKey()
    {
        if (!string.IsNullOrWhiteSpace(apiKeyInput))
        {
            await AnalysisService.SetApiKeyAsync(apiKeyInput.Trim());
            hasApiKey = true;
            showApiKeyInput = false;
            apiKeyInput = "";
        }
    }

    private async Task ClearApiKey()
    {
        await AnalysisService.ClearApiKeyAsync();
        hasApiKey = false;
        showApiKeyInput = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveApiKey();
        }
    }
}
