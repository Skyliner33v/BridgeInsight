@page "/bridgeinsight/portfolio"
@inject BridgeDataService BridgeService
@inject ClaudeAnalysisService AnalysisService
@inject DatabaseService DbService

<PageTitle>Portfolio Analysis — BridgeInsight</PageTitle>

<div class="page-header">
    <div class="container">
        <h1>Portfolio Risk Narrative</h1>
        <p class="page-subtitle">AI-generated risk briefing for non-technical decision-makers</p>
    </div>
</div>

<section class="section">
    <div class="container">
        @if (!DbService.IsInitialized)
        {
            <div class="loading-results">
                <div class="spinner"></div>
                <p>Loading bridge data...</p>
            </div>
        }
        else
        {
            <!-- Mode Indicator -->
            @if (hasApiKey)
            {
                <div class="mode-indicator mode-indicator--live">
                    <span class="mode-badge mode-badge--live">Live</span>
                    <span>Claude API connected — analyses will use real-time AI</span>
                </div>
            }
            else
            {
                <div class="mode-indicator mode-indicator--demo">
                    <span class="mode-badge mode-badge--demo">Demo</span>
                    <span>Using pre-cached responses — <a href="/bridgeinsight">add your API key</a> for live analysis</span>
                </div>
            }

            <!-- Selection Controls -->
            <div class="card selection-card">
                <h3>Select Bridges for Briefing</h3>
                <div class="selection-presets">
                    <button class="btn btn-sm @(selectionMode == "sd" ? "btn-accent" : "btn-outline")"
                            @onclick='() => SelectPreset("sd")'>
                        All Structurally Deficient
                    </button>
                    <button class="btn btn-sm @(selectionMode == "worst" ? "btn-accent" : "btn-outline")"
                            @onclick='() => SelectPreset("worst")'>
                        Top 20 Worst Condition
                    </button>
                    <button class="btn btn-sm @(selectionMode == "county" ? "btn-accent" : "btn-outline")"
                            @onclick='() => SelectPreset("county")'>
                        By County
                    </button>
                </div>

                @if (selectionMode == "county")
                {
                    <div class="form-group" style="max-width: 300px; margin-top: 1rem;">
                        <select class="form-control" @bind="selectedCountyForPortfolio" @bind:after="LoadCountyBridges">
                            <option value="">Select County...</option>
                            @foreach (var county in WaCountyCodes.Codes.OrderBy(c => c.Value))
                            {
                                <option value="@county.Key">@county.Value</option>
                            }
                        </select>
                    </div>
                }

                @if (selectedBridges.Count > 0)
                {
                    <div class="selection-summary">
                        <p><strong>@selectedBridges.Count</strong> bridges selected
                            @if (selectedBridges.Count > 20)
                            {
                                <span class="selection-warning">(max 20 for briefing — first 20 will be used)</span>
                            }
                        </p>
                        <button class="btn btn-accent" @onclick="GenerateBriefing" disabled="@isGenerating">
                            @(isGenerating ? "Generating..." : "Generate Portfolio Briefing")
                        </button>
                    </div>
                }
            </div>

            <!-- Intro & How It Works (shown when no briefing yet) -->
            @if (briefing == null && !isGenerating)
            {
                <div class="intro-section">
                    <div class="intro-text">
                        <h2>AI-Powered Portfolio Intelligence</h2>
                        <p>
                            Traditional bridge risk assessments require engineers to manually cross-reference
                            condition ratings, scour codes, traffic data, and federal standards across dozens of structures.
                            This tool automates that analysis — select a portfolio of bridges and receive a
                            decision-ready briefing in under 60 seconds.
                        </p>
                        <p>
                            Every finding traces back to specific NBI data fields and FHWA coding standards.
                            No black-box conclusions — just <strong>explainable AI</strong> grounded in the same
                            references bridge engineers use daily.
                        </p>
                    </div>
                </div>

                <div class="how-it-works">
                    <h3>How It Works</h3>
                    <div class="pipeline">
                        <div class="pipeline-step">
                            <div class="step-number">1</div>
                            <div class="step-icon">🗂️</div>
                            <h4>Select Portfolio</h4>
                            <p>Choose bridges by deficiency status, worst condition, or county — sourced from 8,400+ WA state structures in the NBI dataset</p>
                        </div>
                        <div class="pipeline-connector"></div>
                        <div class="pipeline-step">
                            <div class="step-number">2</div>
                            <div class="step-icon">🔍</div>
                            <h4>Data Extraction</h4>
                            <p>Condition ratings, scour codes, ADT, material types, and structural metrics are compiled from the in-browser SQLite database</p>
                        </div>
                        <div class="pipeline-connector"></div>
                        <div class="pipeline-step">
                            <div class="step-number">3</div>
                            <div class="step-icon">🧠</div>
                            <h4>AI Analysis</h4>
                            <p>Claude analyzes the portfolio using FHWA reference data as RAG context — classifying risk tiers and identifying cross-portfolio patterns</p>
                        </div>
                        <div class="pipeline-connector"></div>
                        <div class="pipeline-step">
                            <div class="step-number">4</div>
                            <div class="step-icon">📋</div>
                            <h4>Traceable Briefing</h4>
                            <p>Executive summary, per-bridge evidence blocks, funding narrative, and data quality notes — every claim linked to source data</p>
                        </div>
                    </div>
                </div>

                <div class="capabilities-grid">
                    <div class="capability-card">
                        <div class="capability-icon">⚡</div>
                        <h4>Risk Tier Classification</h4>
                        <p>Bridges categorized into Immediate Attention, Near-Term Priority, Monitor, and Satisfactory tiers with rationale for each placement</p>
                    </div>
                    <div class="capability-card">
                        <div class="capability-icon">📊</div>
                        <h4>Evidence-Based Assessment</h4>
                        <p>Per-bridge evidence blocks with condition ratings, risk factors, and one-sentence assessments — no unsupported conclusions</p>
                    </div>
                    <div class="capability-card">
                        <div class="capability-icon">💰</div>
                        <h4>Funding Prioritization</h4>
                        <p>AI-generated funding narrative that prioritizes investment based on structural urgency, traffic impact, and deterioration trajectory</p>
                    </div>
                    <div class="capability-card">
                        <div class="capability-icon">🔗</div>
                        <h4>Full Traceability</h4>
                        <p>Every finding references specific NBI fields and FHWA coding standards — decision-makers can verify any claim against the source data</p>
                    </div>
                </div>

                <div class="demo-callout">
                    <div class="callout-content">
                        <div class="callout-icon">💡</div>
                        <div>
                            <strong>Try it now</strong> — Select a bridge portfolio above and click "Generate Portfolio Briefing."
                            @if (!hasApiKey)
                            {
                                <span>A pre-cached demo response is available instantly, or <a href="/bridgeinsight">add your Claude API key</a> on the BridgeInsight hub for live analysis of any portfolio.</span>
                            }
                            else
                            {
                                <span>Your API key is active — analyses will use the Claude API for real-time results.</span>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Briefing Output -->
            @if (isGenerating)
            {
                <div class="card" style="text-align: center; padding: 3rem;">
                    <div class="spinner"></div>
                    <p>Generating portfolio risk briefing... This may take 30-60 seconds.</p>
                </div>
            }
            else if (briefing != null)
            {
                <div class="card briefing-card">
                    <div class="briefing-header">
                        <h2>Portfolio Risk Briefing</h2>
                        @if (briefing.IsDemo)
                        {
                            <span class="badge badge-demo">Demo Mode</span>
                        }
                    </div>

                    @if (briefing.Error != null)
                    {
                        <div class="analysis-error">
                            <p>@briefing.Error</p>
                        </div>
                    }
                    else
                    {
                        <div class="briefing-section">
                            <h3>Executive Summary</h3>
                            <div class="briefing-text">@briefing.ExecutiveSummary</div>
                        </div>

                        @if (briefing.BridgeEvidenceBlocks.Count > 0)
                        {
                            <div class="briefing-section">
                                <h3>Bridge Evidence Blocks</h3>
                                <div class="evidence-blocks">
                                    @foreach (var block in briefing.BridgeEvidenceBlocks)
                                    {
                                        <div class="bridge-evidence-block">
                                            <div class="block-header">
                                                <strong>@block.Facility</strong>
                                                <span class="mono">@block.StructureNumber</span>
                                            </div>
                                            <p class="block-assessment">@block.OneSentenceAssessment</p>
                                            <div class="block-ratings">
                                                @foreach (var rating in block.KeyRatings)
                                                {
                                                    <span class="rating-badge rating-badge--@GetConditionClass(rating.Value)">
                                                        @rating.Key: @(rating.Value?.ToString() ?? "N/A")
                                                    </span>
                                                }
                                            </div>
                                            @if (block.RiskFactors.Count > 0)
                                            {
                                                <div class="block-risks">
                                                    @foreach (var rf in block.RiskFactors)
                                                    {
                                                        <span class="badge badge-warning">@rf</span>
                                                    }
                                                </div>
                                            }
                                            <div class="block-action">@block.ActionCategory</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(briefing.FundingNarrative))
                        {
                            <div class="briefing-section">
                                <h3>Funding Prioritization Narrative</h3>
                                <div class="briefing-text">@briefing.FundingNarrative</div>
                            </div>
                        }

                        @if (briefing.DataQualityNotes.Count > 0)
                        {
                            <div class="briefing-section">
                                <h3>Data Quality Notes</h3>
                                <ul>
                                    @foreach (var note in briefing.DataQualityNotes)
                                    {
                                        <li>@note</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="analysis-meta">
                            Generated @briefing.GeneratedAt.ToString("MMM dd, yyyy HH:mm UTC")
                            @if (briefing.IsDemo)
                            {
                                <span> &middot; Pre-cached demo response</span>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</section>

@code {
    private List<Bridge> selectedBridges = new();
    private PortfolioBriefingResult? briefing;
    private bool isGenerating;
    private string selectionMode = "";
    private string selectedCountyForPortfolio = "";
    private bool hasApiKey;
    private bool hasCheckedKey;

    protected override async Task OnInitializedAsync()
    {
        if (!DbService.IsInitialized)
            await DbService.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || !hasCheckedKey)
        {
            hasCheckedKey = true;
            var key = await AnalysisService.GetApiKeyAsync();
            var newHasApiKey = !string.IsNullOrEmpty(key);
            if (newHasApiKey != hasApiKey)
            {
                hasApiKey = newHasApiKey;
                StateHasChanged();
            }
        }
    }

    private async Task SelectPreset(string mode)
    {
        selectionMode = mode;
        briefing = null;

        var criteria = new BridgeSearchCriteria { PageSize = 20, Page = 1 };

        switch (mode)
        {
            case "sd":
                criteria.StructurallyDeficientOnly = true;
                criteria.SortBy = "Condition";
                break;
            case "worst":
                criteria.SortBy = "Condition";
                break;
            case "county":
                selectedBridges.Clear();
                return;
        }

        var result = await BridgeService.SearchBridgesAsync(criteria);
        selectedBridges = result.Bridges;
    }

    private async Task LoadCountyBridges()
    {
        if (string.IsNullOrEmpty(selectedCountyForPortfolio)) return;

        var criteria = new BridgeSearchCriteria
        {
            CountyCode = selectedCountyForPortfolio,
            StructurallyDeficientOnly = true,
            SortBy = "Condition",
            PageSize = 20,
            Page = 1
        };

        var result = await BridgeService.SearchBridgesAsync(criteria);
        selectedBridges = result.Bridges;

        if (selectedBridges.Count == 0)
        {
            criteria.StructurallyDeficientOnly = false;
            result = await BridgeService.SearchBridgesAsync(criteria);
            selectedBridges = result.Bridges;
        }
    }

    private async Task GenerateBriefing()
    {
        if (selectedBridges.Count == 0) return;

        isGenerating = true;
        StateHasChanged();

        var bridgesToAnalyze = selectedBridges.Take(20).ToList();
        briefing = await AnalysisService.GeneratePortfolioBriefingAsync(bridgesToAnalyze);

        isGenerating = false;
    }

    private string GetConditionClass(int? rating)
    {
        if (rating == null) return "na";
        return rating switch
        {
            >= 7 => "good",
            >= 5 => "fair",
            4 => "poor",
            _ => "critical"
        };
    }
}
